{
  "name": "construction-company-agency",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "contract:lint": "bunx @stoplight/spectral-cli lint contracts/openapi.yaml --ruleset contracts/.spectral.yaml",
    "contract:generate": "bunx openapi-typescript contracts/openapi.yaml -o src/app/core/platform/api/generated/schema.gen.ts",
    "contract:check": "bunx openapi-typescript contracts/openapi.yaml -o src/app/core/platform/api/generated/schema.gen.ts --check",
    "verify:prerender": "bun scripts/verify-prerender.ts",
    "verify:previa": "bun scripts/verify-previa.ts",
    "gate": "bun run contract:lint && bun run contract:check && bunx ng lint && bunx ng test --watch=false && bunx ng build && bun run verify:prerender && bun run verify:previa"
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@stoplight/spectral-cli": "6.17.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^26.6.3",
    "ajv": "8.20.0",
    "angular-eslint": "22.5.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8"
  }
}
