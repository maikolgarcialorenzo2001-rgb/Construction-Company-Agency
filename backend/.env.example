# Copy to backend/.env and adjust for local development.
PORT=8080
JWT_SECRET=change-me-in-local-dev
CONTRACT_PATH=
TOKEN_TTL=24h

# Optional PostgreSQL DSN. Empty (or unset) selects the in-memory store.
# When set, the server connects via pgx and applies the embedded goose
# migrations at startup.
DATABASE_URL=

# DSN used only by the gated integration suite (make test-integration).
# Never committed with real credentials.
CCA_TEST_DATABASE_URL=postgres://postgres:123@127.0.0.1:5432/cca
